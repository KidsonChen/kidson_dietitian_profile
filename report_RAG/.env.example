"""
環境變量配置模板
複製此文件為 .env 並填入實際值
"""

# 數據庫配置
DATABASE_TYPE=sqlite
DATABASE_PATH=./database/report_rag.db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=report_rag
DATABASE_USER=
DATABASE_PASSWORD=

# 應用配置
APP_DEBUG=False
APP_LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Taipei

# PDF 處理配置
PDF_TIMEOUT=300
PDF_MAX_FILE_SIZE=50
PDF_OCR_ENABLED=False

# Markdown 生成配置
MARKDOWN_TEMPLATE=default
MARKDOWN_INCLUDE_TOC=True
MARKDOWN_CURRENCY=NT$

# 統計配置
STATISTICS_ENABLE_CHARTS=True
STATISTICS_CHART_FORMAT=png

# 銀行配置 (根據需要自定義)
BANKS=bank_a,bank_b,bank_c

# 日誌配置
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5
