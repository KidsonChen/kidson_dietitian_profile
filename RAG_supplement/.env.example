# =============================================
# HuggingFace Inference API（用於 LLM Chat Completion）
# =============================================
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 預設 LLM 模型（可透過 --model 參數覆蓋）
# 推薦使用以下支援 HuggingFace Serverless Inference API 的模型：
# huggingface/mistralai/Mistral-7B-Instruct-v0.3
# huggingface/microsoft/Phi-3-mini-4k-instruct
LLM_MODEL=huggingface/Qwen/Qwen2.5-72B-Instruct

# =============================================
# Embedding Model 設定（sentence-transformers 本地模型）
# 注意：必須使用多語言模型，中文查詢才能命中英文文獻
# 換模型後務必執行 python data_update.py --rebuild 重建索引
# =============================================
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=huggingface/sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# =============================================
# Vector DB 設定（pgvector）
# =============================================
PGVECTOR_CONNECTION_STRING=postgresql://raguser:ragpassword@localhost:5432/ragdb
